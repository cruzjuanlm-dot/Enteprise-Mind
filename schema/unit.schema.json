{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-mind.local/schema/unit.schema.json",
  "title": "Knowledge unit",
  "description": "Frontmatter for a governed Markdown unit. Git history is the version log. The version field is a label, not a second history.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "bucket", "version", "status", "owner", "entities", "supersedes"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "bucket": {
      "enum": ["architecture", "design", "conversations", "decisions", "procedures"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "accepted", "superseded"]
    },
    "owner": {
      "type": "string",
      "pattern": "^person-role\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:system|environment|data-source|table-schema|integration|workflow|project|requirement|use-case|test-case|milestone|decision|person-role|action-item)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "supersedes": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      ]
    }
  }
}
