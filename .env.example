# Names only. Leave values empty to run the local memory stand-in.
# Do not put real keys in this file.

# Supabase project URL, anon key, and service role key.
# The service role is for backend jobs only. The app reads data with the user session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional model extractor. If EXTRACTION_MODEL_API_KEY is unset, extraction is deterministic.
# If the key is set, EXTRACTION_MODEL_BASE_URL must be set too (OpenAI-compatible /chat/completions).
EXTRACTION_MODEL_API_KEY=
EXTRACTION_MODEL_BASE_URL=
EXTRACTION_MODEL=

# Optional: memory | supabase. Unset picks supabase when the three Supabase variables are real, otherwise memory.
# ENTERPRISE_MIND_DATA_MODE=

# The entities page reads with the URL and anon key when both are set.
# When either is empty, that page renders ontology/seed/entities.json instead.
# It does not use the service role key.

# Recall.ai meeting bot. Names only. Set values in the host secret store, not in git.
# RECALL_API_KEY is sent as Authorization: Token <key> from the server.
RECALL_API_KEY=
# Region slug. The API origin is built only from this value.
RECALL_REGION=
# Workspace verification secret. It must use the whsec_ prefix.
RECALL_WORKSPACE_SECRET=
# Comma-separated HTTPS hosts allowed for transcript download URLs.
RECALL_DOWNLOAD_HOSTS=
# true only when the subscription is active. Stripe is not connected.
FLUX_SUBSCRIPTION_ACTIVE=
# Callers of POST /api/bots send Authorization: Bearer <secret>.
FLUX_BOTS_AUTH_SECRET=
# Optional. When one of these is set, meeting notes open a draft pull request.
GITHUB_TOKEN=
FLUX_GITHUB_TOKEN=
# Leave empty or false. Meeting extraction does not call a model.
LLM_ENABLED=
