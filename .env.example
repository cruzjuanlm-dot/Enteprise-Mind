# Names only. Leave values empty to run the local memory stand-in.
# Do not put real keys in this file.

# Supabase project URL, anon key, and service role key.
# The service role is for backend jobs only. The app reads data with the user session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional model extractor. If EXTRACTION_MODEL_API_KEY is unset, extraction is deterministic.
# If the key is set, EXTRACTION_MODEL_BASE_URL must be set too (OpenAI-compatible /chat/completions).
EXTRACTION_MODEL_API_KEY=
EXTRACTION_MODEL_BASE_URL=
EXTRACTION_MODEL=

# Optional: memory | supabase. Unset picks supabase when the three Supabase variables are real, otherwise memory.
# ENTERPRISE_MIND_DATA_MODE=
