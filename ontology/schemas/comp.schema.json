{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-mind.local/ontology/schemas/comp.schema.json",
  "title": "Composition",
  "description": "A versioned reading stored as comps/{id}/COMP.md with this frontmatter. Optional registry_id and capabilities let a comp carry an agent, an MCP connector, a deck, or a course. comp.yaml is not a second file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "version", "status", "owner", "units", "entities"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "accepted", "superseded"]
    },
    "owner": {
      "type": "string",
      "pattern": "^person-role\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-(DEC|REQ|ARC|DS|BR|WF|OQ)-[0-9]{3}$"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:system|environment|data-source|table-schema|integration|workflow|project|requirement|use-case|test-case|milestone|decision|person-role|action-item)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "registry_id": {
      "type": "string",
      "pattern": "^comp\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name"],
        "properties": {
          "kind": {
            "enum": ["agent", "mcp", "deck", "course"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
