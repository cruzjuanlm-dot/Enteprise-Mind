{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-mind.local/ontology/requirement.schema.json",
  "title": "Requirement",
  "description": "A governed statement a project must meet.",
  "type": "object",
  "additionalProperties": false,
  "x-source-of-truth": "git",
  "x-mirror-direction": "git_to_db",
  "x-mirror-note": "Requirements are governed statements in git. A later job copies them into the database.",
  "required": ["id", "type", "name", "summary", "project_id", "statement"],
  "properties": {
    "id": { "type": "string", "pattern": "^requirement\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "requirement" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "pattern": "^project\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "statement": { "type": "string", "minLength": 1 }
  }
}
