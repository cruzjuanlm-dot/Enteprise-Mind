{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-mind.local/ontology/test_case.schema.json",
  "title": "Test case",
  "description": "A check that a requirement holds.",
  "type": "object",
  "additionalProperties": false,
  "x-source-of-truth": "both",
  "x-mirror-direction": "git_to_db",
  "x-mirror-note": "The case text is governed in git and copied into the database later. Execution results are not part of this slice and would stay in the database.",
  "required": ["id", "type", "name", "summary", "requirement_id", "expected"],
  "properties": {
    "id": { "type": "string", "pattern": "^test-case\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "test_case" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "requirement_id": { "type": "string", "pattern": "^requirement\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "expected": { "type": "string", "minLength": 1 }
  }
}
