{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-mind.local/ontology/system.schema.json",
  "title": "System",
  "description": "A named software system.",
  "type": "object",
  "additionalProperties": false,
  "x-source-of-truth": "both",
  "x-mirror-direction": "git_to_db",
  "x-mirror-note": "Git holds the governed description. A later job copies that description into the systems row. It does not write database edits back to git.",
  "required": ["id", "type", "name", "summary", "kind", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^system\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "system" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["product", "platform", "service"] },
    "status": { "enum": ["proposed", "active", "retired"] }
  }
}
